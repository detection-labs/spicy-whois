protocol analyzer WHOIS over TCP:
    parse originator with WHOIS::Request,
    parse responder with WHOIS::Reply;

import WHOIS;

export WHOIS::Request;
export WHOIS::Reply;

on WHOIS::Request -> event WHOIS::request($conn, $is_orig, self);
on WHOIS::Reply -> event WHOIS::reply($conn, $is_orig, self);
